# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Mapbox public token (pk.*) — safe to expose client-side, URL-restrict in Mapbox dashboard
VITE_MAPBOX_TOKEN=pk.your-mapbox-public-token

# Server-only (set in Netlify env, never commit)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JT_API_KEY=your-jobtread-pave-api-key
JT_ORG_ID=your-jobtread-org-id
